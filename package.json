  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "node sidecar-app/index.js",
    "dev:tauri": "concurrently --kill-others --kill-others-on-fail \"node sidecar-app/index.js\" \"tauri dev\"",
    "build": "tsc && vite build",
